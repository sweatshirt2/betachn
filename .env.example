# PostgreSQL connection string (required by web API routes and the worker)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chorify

# Bearer token guarding worker /admin/* endpoints (worker only)
WORKER_ADMIN_TOKEN=replace-with-a-long-random-secret

# Google OAuth (web only; optional until the /auth/google route is enabled —
# plan §4.16: required once the Google route is enabled, fail-fast at boot)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
